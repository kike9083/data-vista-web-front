
# Habilitar el motor de reescritura
RewriteEngine On

# Si la solicitud no es un archivo existente
RewriteCond %{REQUEST_FILENAME} !-f
# Si la solicitud no es un directorio existente
RewriteCond %{REQUEST_FILENAME} !-d
# Si la solicitud no es para /api/ (para evitar redireccionar las llamadas a la API)
RewriteCond %{REQUEST_URI} !^/api/
# Reescribir todas las demás solicitudes al index.html
RewriteRule ^ index.html [QSA,L]

# Habilitar Cross-Origin Resource Sharing (CORS)
Header set Access-Control-Allow-Origin "*"
Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
Header set Access-Control-Allow-Headers "Content-Type, Authorization"

# Establecer tipos MIME adecuados
AddType application/javascript .js
AddType text/css .css

# Compresión para mejorar el rendimiento
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# Caché del navegador para recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Prevenir acceso a archivos sensibles
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

<FilesMatch "(\.json|\.lock|\.git|\.env|package\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Proteger el directorio de API del acceso directo al archivo PHP
<Files "data.php">
  # Permitir acceso solo a través de la solicitud adecuada
  <If "%{QUERY_STRING} !~ /offset=/">
    Require all denied
  </If>
</Files>
